{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Polytopic-Lab/lido/conformance/manifest.schema.json",
  "title": "Lido conformance case file",
  "description": "One file per (schema, kind). See conformance/README.md and D-007.",
  "type": "object",
  "required": ["manifest_version", "schema", "kind", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "manifest_version": { "const": 1 },
    "schema": {
      "description": "File name of the CDDL schema under schemas/.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.cddl$"
    },
    "kind": {
      "enum": ["positive", "negative", "noncanonical", "encode_error", "evolution"]
    },
    "cases": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "positive" } } },
      "then": {
        "properties": { "cases": { "items": { "$ref": "#/$defs/positiveCase" } } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "negative" } } },
      "then": {
        "properties": { "cases": { "items": { "$ref": "#/$defs/negativeCase" } } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "noncanonical" } } },
      "then": {
        "properties": { "cases": { "items": { "$ref": "#/$defs/noncanonicalCase" } } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "encode_error" } } },
      "then": {
        "properties": { "cases": { "items": { "$ref": "#/$defs/encodeErrorCase" } } }
      }
    },
    {
      "$comment": "The evolution record is defined by slice 1.4; until then no case may take that shape.",
      "if": { "properties": { "kind": { "const": "evolution" } } },
      "then": { "properties": { "cases": false } }
    }
  ],
  "$defs": {
    "positiveCase": {
      "type": "object",
      "required": [
        "id",
        "root",
        "description",
        "requirements",
        "derivation",
        "value",
        "cbor",
        "json"
      ],
      "properties": {
        "id": {
          "description": "<schema-stem>/<case-name>, lower snake_case. Stable for the life of the project.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*/[a-z][a-z0-9_]*$"
        },
        "root": {
          "description": "Name of the type in the schema that value is an instance of.",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "description": { "type": "string", "minLength": 1 },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^REQ-[A-Z]+-[0-9]{3}$" }
        },
        "derivation": {
          "enum": ["rfc8949-appendix-a", "hand-encoded", "cbor2"]
        },
        "value": { "$ref": "#/$defs/value" },
        "cbor": {
          "description": "Canonical CBOR (REQ-RT-160), lowercase hex, no prefix or separators.",
          "type": "string",
          "pattern": "^([0-9a-f]{2})+$"
        },
        "json": {
          "description": "Exact expected JSON text, compact (REQ-RT-175), members in canonical order (REQ-RT-177).",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "value": {
      "description": "Self-describing logical value: an object with exactly one member, a type tag.",
      "oneOf": [
        { "$ref": "#/$defs/tagBool" },
        { "$ref": "#/$defs/tagUint" },
        { "$ref": "#/$defs/tagInt" },
        { "$ref": "#/$defs/tagF16" },
        { "$ref": "#/$defs/tagF32" },
        { "$ref": "#/$defs/tagF64" },
        { "$ref": "#/$defs/tagTstr" },
        { "$ref": "#/$defs/tagBstr" },
        { "$ref": "#/$defs/tagNull" },
        { "$ref": "#/$defs/tagArray" },
        { "$ref": "#/$defs/tagMap" }
      ]
    },
    "tagBool": {
      "type": "object",
      "required": ["bool"],
      "properties": { "bool": { "type": "boolean" } },
      "additionalProperties": false
    },
    "tagUint": {
      "type": "object",
      "required": ["uint"],
      "properties": { "uint": { "$ref": "#/$defs/uintString" } },
      "additionalProperties": false
    },
    "tagInt": {
      "type": "object",
      "required": ["int"],
      "properties": { "int": { "$ref": "#/$defs/intString" } },
      "additionalProperties": false
    },
    "tagF16": {
      "type": "object",
      "required": ["f16"],
      "properties": { "f16": { "$ref": "#/$defs/floatString" } },
      "additionalProperties": false
    },
    "tagF32": {
      "type": "object",
      "required": ["f32"],
      "properties": { "f32": { "$ref": "#/$defs/floatString" } },
      "additionalProperties": false
    },
    "tagF64": {
      "type": "object",
      "required": ["f64"],
      "properties": { "f64": { "$ref": "#/$defs/floatString" } },
      "additionalProperties": false
    },
    "tagTstr": {
      "type": "object",
      "required": ["tstr"],
      "properties": { "tstr": { "type": "string" } },
      "additionalProperties": false
    },
    "tagBstr": {
      "type": "object",
      "required": ["bstr"],
      "properties": {
        "bstr": { "type": "string", "pattern": "^([0-9a-f]{2})*$" }
      },
      "additionalProperties": false
    },
    "tagNull": {
      "type": "object",
      "required": ["null"],
      "properties": { "null": { "type": "null" } },
      "additionalProperties": false
    },
    "tagArray": {
      "type": "object",
      "required": ["array"],
      "properties": {
        "array": { "type": "array", "items": { "$ref": "#/$defs/value" } }
      },
      "additionalProperties": false
    },
    "tagMap": {
      "type": "object",
      "required": ["map"],
      "properties": {
        "map": {
          "description": "[key, value] pairs in expected wire order. Keys are tstr or uint.",
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              { "oneOf": [{ "$ref": "#/$defs/tagTstr" }, { "$ref": "#/$defs/tagUint" }] },
              { "$ref": "#/$defs/value" }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": false
    },
    "input": {
      "description": "A decode input: exactly one of CBOR (lowercase hex, possibly empty) or JSON (exact text, possibly empty).",
      "type": "object",
      "properties": {
        "cbor": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
        "json": { "type": "string" }
      },
      "oneOf": [{ "required": ["cbor"] }, { "required": ["json"] }],
      "additionalProperties": false
    },
    "negativeCase": {
      "description": "A decode that must fail. classification is the DoD's two-way split (D-010).",
      "type": "object",
      "required": ["id", "root", "description", "requirements", "derivation", "input", "classification", "error"],
      "properties": {
        "id": { "$ref": "#/$defs/positiveCase/properties/id" },
        "root": { "$ref": "#/$defs/positiveCase/properties/root" },
        "description": { "$ref": "#/$defs/positiveCase/properties/description" },
        "requirements": { "$ref": "#/$defs/positiveCase/properties/requirements" },
        "derivation": { "$ref": "#/$defs/positiveCase/properties/derivation" },
        "input": { "$ref": "#/$defs/input" },
        "classification": { "enum": ["malformed", "schema_invalid"] },
        "error": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": [
                "truncated", "trailing_data", "syntax", "invalid_utf8", "duplicate_key",
                "type_mismatch", "missing_field", "null_not_allowed", "unknown_discriminant",
                "invalid_choice", "out_of_range", "wrong_length", "bad_key"
              ]
            },
            "path": { "type": "string" },
            "discriminant": { "type": "string" },
            "constraint": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "classification": { "const": "malformed" } } },
          "then": {
            "properties": {
              "error": {
                "properties": {
                  "kind": { "enum": ["truncated", "trailing_data", "syntax", "invalid_utf8", "duplicate_key"] }
                },
                "not": { "required": ["path"] }
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "required": ["path"],
                "properties": {
                  "kind": {
                    "enum": [
                      "type_mismatch", "missing_field", "null_not_allowed", "unknown_discriminant",
                      "invalid_choice", "out_of_range", "wrong_length", "bad_key"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "noncanonicalCase": {
      "description": "An input a decoder must accept, with the canonical vector it is equivalent to.",
      "type": "object",
      "required": ["id", "root", "description", "requirements", "derivation", "variance", "input", "value", "cbor"],
      "properties": {
        "id": { "$ref": "#/$defs/positiveCase/properties/id" },
        "root": { "$ref": "#/$defs/positiveCase/properties/root" },
        "description": { "$ref": "#/$defs/positiveCase/properties/description" },
        "requirements": { "$ref": "#/$defs/positiveCase/properties/requirements" },
        "derivation": { "$ref": "#/$defs/positiveCase/properties/derivation" },
        "variance": {
          "enum": [
            "indefinite_length", "unsorted_keys", "non_shortest_head", "wider_float", "non_canonical_nan",
            "whitespace", "string_escapes", "number_spelling", "int_as_string", "int_as_number",
            "base64_padding", "member_order", "absent_default"
          ]
        },
        "input": { "$ref": "#/$defs/input" },
        "value": { "$ref": "#/$defs/value" },
        "cbor": { "$ref": "#/$defs/positiveCase/properties/cbor" },
        "json": { "$ref": "#/$defs/positiveCase/properties/json" }
      },
      "additionalProperties": false
    },
    "encodeError": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["kind", "path"],
          "properties": {
            "kind": { "enum": ["not_representable", "out_of_range"] },
            "path": { "type": "string" },
            "constraint": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "encodeErrorCase": {
      "description": "An encode that must fail in at least one encoding; the other, if it succeeds, gives its exact output.",
      "type": "object",
      "required": ["id", "root", "description", "requirements", "derivation", "value", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/positiveCase/properties/id" },
        "root": { "$ref": "#/$defs/positiveCase/properties/root" },
        "description": { "$ref": "#/$defs/positiveCase/properties/description" },
        "requirements": { "$ref": "#/$defs/positiveCase/properties/requirements" },
        "derivation": { "$ref": "#/$defs/positiveCase/properties/derivation" },
        "value": { "$ref": "#/$defs/value" },
        "expect": {
          "type": "object",
          "required": ["cbor", "json"],
          "properties": {
            "cbor": {
              "oneOf": [{ "$ref": "#/$defs/positiveCase/properties/cbor" }, { "$ref": "#/$defs/encodeError" }]
            },
            "json": {
              "oneOf": [{ "$ref": "#/$defs/positiveCase/properties/json" }, { "$ref": "#/$defs/encodeError" }]
            }
          },
          "anyOf": [
            { "properties": { "cbor": { "type": "object" } } },
            { "properties": { "json": { "type": "object" } } }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "uintString": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "intString": { "type": "string", "pattern": "^(0|-?[1-9][0-9]*)$" },
    "floatString": {
      "description": "Decimal, C99 hex-float, NaN, Infinity or -Infinity.",
      "type": "string",
      "pattern": "^(NaN|-?Infinity|-?0x[0-9a-fA-F]+(\\.[0-9a-fA-F]*)?p[+-]?[0-9]+|-?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?)$"
    }
  }
}
